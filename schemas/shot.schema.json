{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "character_id",
    "master_version",
    "aspect_ratio",
    "shots"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "character_id": {
      "type": "string",
      "minLength": 1
    },
    "master_version": {
      "type": "string",
      "minLength": 1
    },
    "aspect_ratio": {
      "enum": [
        "9:16",
        "16:9",
        "3:4",
        "1:1"
      ]
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "character_id",
          "master_version",
          "image_file"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "character_id": {
            "type": "string",
            "minLength": 1
          },
          "master_version": {
            "type": "string",
            "minLength": 1
          },
          "image_file": {
            "type": "string",
            "minLength": 1
          },
          "props": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/prop"
            }
          },
          "sword_state": {
            "enum": [
              "sheathed",
              "partially_drawn",
              "drawn"
            ]
          },
          "scabbard_location": {
            "type": "string",
            "minLength": 1
          },
          "scabbard_move_action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "prop": {
      "type": "object",
      "required": [
        "state",
        "location"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "transition_action": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "holder": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
