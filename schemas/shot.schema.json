{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "project_id",
    "character_id",
    "master_version",
    "aspect_ratio",
    "shots"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "character_id": {
      "type": "string"
    },
    "master_version": {
      "type": "string"
    },
    "aspect_ratio": {
      "enum": [
        "9:16",
        "16:9",
        "3:4",
        "1:1"
      ]
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "sword_state",
          "scabbard_location",
          "character_id",
          "master_version",
          "image_file"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "sword_state": {
            "enum": [
              "sheathed",
              "partially_drawn",
              "drawn"
            ]
          },
          "scabbard_location": {
            "type": "string"
          },
          "scabbard_move_action": {
            "type": "string"
          },
          "character_id": {
            "type": "string"
          },
          "master_version": {
            "type": "string"
          },
          "image_file": {
            "type": "string"
          }
        }
      }
    }
  }
}