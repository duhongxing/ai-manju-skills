{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "character_id",
    "master_version",
    "dna",
    "views",
    "master_file"
  ],
  "properties": {
    "character_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "master_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "dna": {
      "type": "object",
      "minProperties": 1
    },
    "views": {
      "type": "object",
      "required": [
        "front",
        "side",
        "back"
      ],
      "properties": {
        "front": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "side": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "back": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "master_file": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "additionalProperties": false
}
