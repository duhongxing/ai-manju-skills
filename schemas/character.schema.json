{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "character_id",
    "master_version",
    "dna",
    "views"
  ],
  "properties": {
    "character_id": {
      "type": "string",
      "minLength": 1
    },
    "master_version": {
      "type": "string",
      "minLength": 1
    },
    "dna": {
      "type": "object"
    },
    "views": {
      "type": "object",
      "required": [
        "front",
        "side",
        "back"
      ],
      "properties": {
        "front": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "type": "string",
          "minLength": 1
        },
        "back": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}